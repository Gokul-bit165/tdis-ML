# Mapbox public access token
VITE_MAPBOX_TOKEN=your-mapbox-token-here

# Cube.js backend API base URL
VITE_CUBE_API_BASE_URL=http://your-cube-backend-url

# Cube.js auth token
VITE_CUBEJS_TOKEN=your-cubejs-token-here

# Google analytics code
REACT_APP_GOOGLE_ANALYTICS_TRACKING_ID=google-analytics-token

#App Intake API key
VITE_TDIS_API_KEY=tdis-app-intake-api-key

# Portal REST API (events, LTS, hazards, power outage, Flood Hub gauges). Include /api/v1.
# CI: `tdis-portal-api-new-url` → VITE_API_URL
VITE_API_URL=https://api-new-portal.dev.cloud.tdis.io/api/v1

# Optional: base for Contact Us / email subscribe only (legacy `/api/emails/*` on older host).
# CI: `tdis-portal-api-url` → VITE_EMAIL_API_URL. If unset locally, mutations use `VITE_API_URL`.
# VITE_EMAIL_API_URL=https://another-host.dev.cloud.tdis.io/api/v1

# Wildfire Ignition model API (tdis-ignition-api). Defaults to http://localhost:8001
# VITE_IGNITION_API_URL=http://localhost:8001

# Map vector tiles (pg_tileserv) — separate from portal API
# VITE_TILE_SERVER_BASE_URL=https://portal-pgtile.dev.cloud.tdis.io

# RAMP API root for critical facilities GeoJSON (schools / hospitals / fire stations).
# CI: Key Vault `tdis-dev-ramp-api-root` → VITE_RAMP_API_ROOT
# VITE_RAMP_API_ROOT=https://your-ramp-api-host
# Optional API key if RAMP requires it:
# VITE_RAMP_API_KEY=
# Optional: limit to one county for faster local testing (e.g. 201 = Harris).
# Leave unset to load all Texas counties (statewide merge).
# VITE_RAMP_POI_COUNTY=201